# --- App ---
ENVIRONMENT=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database ---
POSTGRES_PASSWORD=mingly_dev_password
DATABASE_URL=postgresql+psycopg2://mingly:mingly_dev_password@db:5432/mingly

# --- Sessions ---
SESSION_SECRET=replace-with-a-long-random-string

# --- LinkedIn OAuth (create app at https://www.linkedin.com/developers/apps) ---
# Product to request: "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# --- Email (any SMTP provider: Resend, Postmark, Amazon SES, ...) ---
# Leave SMTP_HOST empty to skip sending (emails are logged instead).
# Resend example: SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USERNAME=resend SMTP_PASSWORD=<API key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Mingly <hello@mingly.ai>
